# =====================================================================
# LOCAL DEVELOPMENT
# Copy to .env and fill in. Never commit the real .env.
# =====================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api

# Comma-separated. Must include every origin the frontend is served from.
CORS_ORIGINS=http://localhost:5173,https://aathif-thahir-profile.vercel.app

# Origin used to build stored file URLs (avatars, documents, resume).
PUBLIC_BASE_URL=http://localhost:4000

# --- Database ---------------------------------------------------------
# Either DATABASE_URL alone, or the discrete DB_* fields below.
# Managed providers (Neon, Supabase, Aiven, Render) give you a URL.
# DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=portfolio

# Auto-create tables from entities. Development only — use migrations in prod.
DB_SYNCHRONIZE=true
DB_LOGGING=false
# Defaults to true in production, false otherwise.
# DB_SSL=false
# Pool ceiling per process. Defaults to 1 on Vercel, 10 elsewhere.
# DB_POOL_SIZE=10

# --- Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=aathifinfo116@gmail.com
ADMIN_PASSWORD=ChangeThisPassword123!

# --- Storage ----------------------------------------------------------
# Only `local` is implemented. Local disk does NOT work on Vercel: the
# function filesystem is read-only and ephemeral. See DEPLOYMENT.md.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
