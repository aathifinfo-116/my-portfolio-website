# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=portfolio
# Auto-create tables from entities. Use ONLY in development; use migrations in prod.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Auth ---
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=1d
# Seeded admin account (used by `npm run seed`)
ADMIN_EMAIL=aathifinfo116@gmail.com
ADMIN_PASSWORD=ChangeThisPassword123!

# --- Storage ---
# local | cloudinary | s3   (only `local` is implemented; others are stubbed behind the same interface)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
MAX_UPLOAD_MB=10
