# Leave empty to use the Vite dev proxy (recommended for local development).
#
# When the frontend is deployed separately, set the API's full origin —
# including the scheme, with no trailing slash and no /api suffix:
#
#   VITE_API_BASE_URL=https://my-portfolio-api.vercel.app
#
# Vite inlines this at BUILD time, so changing it in the Vercel dashboard has
# no effect until you redeploy.
VITE_API_BASE_URL=
